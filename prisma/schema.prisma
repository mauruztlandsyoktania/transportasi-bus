// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  password String
  role     Role      @default(USER)
  bookings Booking[]
}

model Bus {
  id       Int       @id @default(autoincrement())
  name     String
  fromCity String
  toCity   String
  price    Int
  seats    Int
  bookings Booking[]
}

model Booking {
  id          Int      @id @default(autoincrement())
  userId      Int
  busId       Int
  jumlahTiket Int
  totalHarga  Int
  status      String   @default("PENDING")

  user    User     @relation(fields: [userId], references: [id])
  bus     Bus      @relation(fields: [busId], references: [id])
  payment Payment?
}

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int           @unique
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING) // Diubah defaultnya ke PENDING agar lebih logis untuk transaksi baru
  createdAt     DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
}

// Mengembalikan CASH agar tidak terjadi error data loss di database Railway
enum PaymentMethod {
  EWALLET
  TRANSFER
  CASH
}

// Mengembalikan PENDING dan FAILED agar data lama di database tidak bentrok
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Role {
  ADMIN
  USER
}